{
  "name": "signalk-zigbee",
  "version": "0.1.0",
  "description": "Zigbee sensors and switches in Signal K: runs Zigbee2MQTT and Mosquitto as managed containers and maps every device to Signal K paths automatically, with PUT support for writable values.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "public",
    "doc",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run typecheck:test && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "prettier": "prettier --write .",
    "lint": "eslint --fix",
    "format": "npm run prettier && npm run lint",
    "ci-lint": "eslint && prettier --check .",
    "release": "git tag -d v$npm_package_version; git tag v$npm_package_version && git push && git push origin v$npm_package_version",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-hardware",
    "signalk-category-utility",
    "zigbee",
    "zigbee2mqtt",
    "mqtt",
    "sensors",
    "marine"
  ],
  "author": "Dirk Wahrheit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirkwa/signalk-zigbee.git"
  },
  "signalk": {
    "displayName": "Zigbee (Zigbee2MQTT)",
    "appIcon": "public/icon.svg",
    "requires": [
      "signalk-container"
    ],
    "screenshots": [
      "./doc/screenshots/1_signalk-zigbee.png"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "mqtt": "^5.15.0",
    "signalk-container-helper": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@signalk/server-api": "^2.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.10"
  }
}
